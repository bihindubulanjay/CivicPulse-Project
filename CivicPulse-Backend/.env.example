# Server binding & networking
HOST=0.0.0.0
PORT=8080
# Comma-separated origins for strict CORS (leave empty or '*' for permissive dev mode)
ALLOWED_ORIGINS=
# Set true ONLY behind a trusted reverse proxy (Nginx / Cloudflare / Cloud Run)
TRUST_PROXY_HEADERS=false

# Database & connection pool
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicpulse
DATABASE_PATH=./data/civicpulse.db
DB_POOL_SIZE=8
SEED_INITIAL_POSTS=false

# Media storage ('file' writes uploads to UPLOAD_DIR and serves /uploads/{file}; 'inline' keeps data URIs)
MEDIA_STORAGE_MODE=file
UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=
MAX_BODY_SIZE_BYTES=15728640
MAX_DECODED_MEDIA_BYTES=12582912

# Google Gemini Flash API (required for live multimodal forensics & tactical AI chat)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent
GEMINI_FALLBACK_ENDPOINTS=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent,https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
GEMINI_TIMEOUT_SECS=20
AI_RETRY_INTERVAL_SECS=60

# Trust Engine, Rate Limiting & Auth
GEOFENCE_RADIUS_KM=15.0
RATE_LIMIT_POST_PER_MIN=10
AUTH_RATE_LIMIT_PER_15MIN=15
STRICT_UNIQUE_VOTERS=true
SESSION_TTL_HOURS=24
ALLOW_GUEST_UPLOADS_DEFAULT=true
STALE_ALERT_HOURS=72

# Optional initial account bootstrap (leave blank in production — the first registered user automatically becomes Admin)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=CivicPulse Admin
USER_SEED_EMAIL=
USER_SEED_PASSWORD=
USER_SEED_NAME=CivicPulse Reporter

# Optional HMAC-SHA256 signed emergency webhook for verified Danger alerts (severity >= 8)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Structured logging filter
RUST_LOG=civicpulse_backend=info,tower_http=info
