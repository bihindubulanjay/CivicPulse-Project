# Root CivicPulse Environment Template (NO real secrets)

# Shared API & AI Configuration
HOST=0.0.0.0
PORT=8080
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicpulse
DATABASE_PATH=./data/civicpulse.db

# CivicPulse-Backend Security & Storage
MEDIA_STORAGE_MODE=file
UPLOAD_DIR=./data/uploads
ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false
GEOFENCE_RADIUS_KM=15.0
RATE_LIMIT_POST_PER_MIN=10
AUTH_RATE_LIMIT_PER_15MIN=15
STRICT_UNIQUE_VOTERS=false
SESSION_TTL_HOURS=24
ALLOW_GUEST_UPLOADS_DEFAULT=true

# Initial Seed Accounts (override in production)
ADMIN_SEED_EMAIL=admin@civicpulse.org
ADMIN_SEED_PASSWORD=admin123
USER_SEED_EMAIL=user@civicpulse.org
USER_SEED_PASSWORD=user123

# CivicPulse-Frontend / CivicPulse-CLI Integration
NEXT_PUBLIC_API_URL=http://localhost:8080
CIVICPULSE_API_URL=http://localhost:8080
