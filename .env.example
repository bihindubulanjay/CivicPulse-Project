# Root CivicPulse Environment Template (NO real secrets)

# PostgreSQL Configuration (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=civicpulse
DATABASE_URL=postgres://postgres:replace_with_strong_password@db:5432/civicpulse

# Server & Reverse Proxy Binding
HOST=0.0.0.0
PORT=8080
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8080
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=https://bihindubulanjay.github.io,http://localhost:3001
TRUST_PROXY_HEADERS=true

# AI Verification & Safety Advisor
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent
GEMINI_FALLBACK_ENDPOINTS=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent,https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
GEMINI_TIMEOUT_SECS=20

# CivicPulse-Backend Persistence & Security
DATABASE_PATH=./data/civicpulse.db
UPLOAD_DIR=./data/uploads
MEDIA_STORAGE_MODE=file
GEOFENCE_RADIUS_KM=15.0
RATE_LIMIT_POST_PER_MIN=10
AUTH_RATE_LIMIT_PER_15MIN=15
STRICT_UNIQUE_VOTERS=true
SEED_INITIAL_POSTS=false
SESSION_TTL_HOURS=24
ALLOW_GUEST_UPLOADS_DEFAULT=true

# Frontend Console Build & API URL
VITE_API_BASE_URL=http://localhost:8080
